{
  "name": "static-a11y-check",
  "version": "0.2.0",
  "description": "Accessibility checks for a built static site with pa11y-ci, plus color contrast under forced :hover and :focus-visible",
  "license": "MIT",
  "author": "Curlew Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/curlewlabs-com/static-a11y-check.git"
  },
  "type": "module",
  "exports": "./lib/index.mjs",
  "bin": {
    "static-a11y-check": "bin/static-a11y-check.mjs"
  },
  "files": [
    "bin/",
    "lib/"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"test/unit/*.test.mjs\"",
    "test:e2e": "node --test \"test/e2e/*.test.mjs\""
  },
  "dependencies": {
    "pa11y-ci": "4.1.1"
  }
}
